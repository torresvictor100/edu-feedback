# Banco de dados (compartilhado por backend/ e functions/)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=edufeedback
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Segurança (Serviço A e Serviço B — mesmo segredo nos dois)
JWT_SECRET=
JWT_EXPIRATION_MS=3600000

# Regra de negócio
NOTA_CRITICA_LIMITE=3

# Azure — mensageria e e-mail (Serviço B)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_COMMUNICATION_SERVICES_CONNECTION_STRING=
AZURE_COMMUNICATION_SERVICES_SENDER_ADDRESS=

# Azure — observabilidade (ambos os serviços)
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Função Timer — periodicidade do relatório agendado (formato NCRONTAB do Azure Functions)
RELATORIO_AGENDADO_CRON=0 0 8 * * 1
