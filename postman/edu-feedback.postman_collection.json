{
  "info": {
    "name": "EduFeedback",
    "description": "Coleção de testes manuais do EduFeedback: Serviço A (API principal, Spring Boot) e Serviço B (funções serverless, Quarkus/Azure Functions).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Serviço A - API principal",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/actuator/health", "host": ["{{baseUrl}}"], "path": ["actuator", "health"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Status UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"senha\": \"{{adminSenha}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Token presente', () => pm.expect(body.token).to.not.be.empty);",
                  "pm.collectionVariables.set('token', body.token);",
                  "pm.environment.set('token', body.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Enviar avaliação (nota normal)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descricao\": \"Aula muito boa, professor claro\",\n  \"nota\": 9\n}"
            },
            "url": { "raw": "{{baseUrl}}/avaliação", "host": ["{{baseUrl}}"], "path": ["avaliação"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Urgência NORMAL', () => pm.expect(body.urgencia).to.eql('NORMAL'));",
                  "pm.environment.set('avaliacaoId', body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Enviar avaliação (nota crítica)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descricao\": \"Não consegui acompanhar a aula, muito confuso\",\n  \"nota\": 2\n}"
            },
            "url": { "raw": "{{baseUrl}}/avaliação", "host": ["{{baseUrl}}"], "path": ["avaliação"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Urgência CRITICA', () => pm.expect(body.urgencia).to.eql('CRITICA'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar relatório",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/relatorios/{{relatorioId}}",
              "host": ["{{baseUrl}}"],
              "path": ["relatorios", "{{relatorioId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 ou 404 (se ainda não processado)', () => {",
                  "  pm.expect([200, 404]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Serviço B - Funções serverless",
      "item": [
        {
          "name": "Health check (função HTTP)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{functionsBaseUrl}}/health", "host": ["{{functionsBaseUrl}}"], "path": ["health"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Solicitar relatório sob demanda",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{functionsBaseUrl}}/relatorios/solicitacoes",
              "host": ["{{functionsBaseUrl}}"],
              "path": ["relatorios", "solicitacoes"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 202', () => pm.response.to.have.status(202));",
                  "const body = pm.response.json();",
                  "pm.test('Status PROCESSANDO', () => pm.expect(body.status).to.eql('PROCESSANDO'));",
                  "pm.environment.set('relatorioId', body.id);"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "functionsBaseUrl", "value": "http://localhost:7071/api" },
    { "key": "token", "value": "" }
  ]
}
