{
  "info": {
    "name": "EduFeedback",
    "description": "Coleção de testes manuais do EduFeedback: Serviço A (API principal, Spring Boot). O Serviço B (2 funções serverless: timer de relatório agendado e queue de notificação crítica) não expõe nenhum endpoint HTTP — não é testável via Postman. Para verificar as funções, acompanhe os logs no Application Insights / portal do Function App, ou rode `mvn azure-functions:run` localmente com Azure Functions Core Tools e acione manualmente pelo portal.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Serviço A - API principal",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/actuator/health", "host": ["{{baseUrl}}"], "path": ["actuator", "health"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Status UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"senha\": \"{{adminSenha}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Token presente', () => pm.expect(body.token).to.not.be.empty);",
                  "pm.collectionVariables.set('token', body.token);",
                  "pm.environment.set('token', body.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Enviar avaliação (nota normal)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descricao\": \"Aula muito boa, professor claro\",\n  \"nota\": 9\n}"
            },
            "url": { "raw": "{{baseUrl}}/avaliação", "host": ["{{baseUrl}}"], "path": ["avaliação"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Urgência NORMAL', () => pm.expect(body.urgencia).to.eql('NORMAL'));",
                  "pm.environment.set('avaliacaoId', body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Enviar avaliação (nota crítica)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descricao\": \"Não consegui acompanhar a aula, muito confuso\",\n  \"nota\": 2\n}"
            },
            "url": { "raw": "{{baseUrl}}/avaliação", "host": ["{{baseUrl}}"], "path": ["avaliação"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Urgência CRITICA', () => pm.expect(body.urgencia).to.eql('CRITICA'));",
                  "// Esta requisição enfileira uma notificação em \"notificacoes-criticas\";",
                  "// FeedbackCriticoFunction (Serviço B) consome e envia o e-mail — verificar nos logs do Function App."
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar relatório",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/relatorios/{{relatorioId}}",
              "host": ["{{baseUrl}}"],
              "path": ["relatorios", "{{relatorioId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 ou 404 (se ainda não processado)', () => {",
                  "  pm.expect([200, 404]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "relatorioId", "value": "", "description": "Preencher com o id gerado por RelatorioAgendadoFunction (Serviço B) — consultar direto na tabela relatorios, já que não há endpoint para listá-los nesta versão." }
  ]
}
